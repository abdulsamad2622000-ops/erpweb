{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "name": "erp-web",
    "note": "App shell prefetched (index, css, translations). JS chunks are cached the first time they load (lazy), so phones do not download barcode/Excel libraries until used. API calls are NOT cached (IndexedDB handles scan data)."
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/i18n/*.json"
        ]
      }
    },
    {
      "name": "app-code",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/*.js"
        ]
      }
    },
    {
      "name": "fonts-and-icons",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.woff2"
        ]
      }
    },
    {
      "name": "old-font-formats",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/media/**",
          "/icons/**",
          "/**/*.(woff|ttf|otf|eot)"
        ]
      }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif)"
        ]
      }
    }
  ]
}
